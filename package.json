{
  "name": "rota-poliglota",
  "productName": "Projeto Hermes",
  "version": "1.5.0",
  "description": "Guia de estudo de idiomas (inglês, espanhol, francês, russo, turco e árabe) do A1 ao C2.",
  "main": "electron/main.js",
  "author": "Fábio",
  "license": "UNLICENSED",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/fabiob8856/Rota-poliglota-projeto.git" },
  "scripts": {
    "build:app": "node tools/build.js",
    "start": "node tools/build.js && electron .",
    "dist": "node tools/build.js && electron-builder --win --publish never",
    "release": "node tools/build.js && electron-builder --win --publish always"
  },
  "dependencies": { "electron-updater": "^6.3.9" },
  "devDependencies": { "electron": "^33.2.1", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.fabio.rotapoliglota",
    "productName": "Projeto Hermes",
    "files": ["electron/**", "app/**", "build/icon.png", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "artifactName": "Projeto-Hermes-Setup-${version}.${ext}",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Projeto Hermes", "deleteAppDataOnUninstall": false },
    "publish": [{ "provider": "github", "owner": "fabiob8856", "repo": "Rota-poliglota-projeto", "releaseType": "release" }]
  }
}
